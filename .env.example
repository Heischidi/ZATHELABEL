# ============================================================
# ZA Fashion E-Commerce — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# -------------------------------------------------------
# DATABASE — Supabase PostgreSQL (Free Tier)
# -------------------------------------------------------
# Get both URLs from: Supabase Dashboard → Project Settings → Database
#
# Transaction Pooler URL (port 6543) — used by the RUNNING APP
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:your_password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Direct URL (port 5432) — used ONLY for running `alembic upgrade head` locally
# Format: postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:your_password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# -------------------------------------------------------
# BACKEND — JWT & Security
# -------------------------------------------------------
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------------------------------------
# CLOUDINARY — Image Uploads (free tier: 25GB)
# Sign up at https://cloudinary.com
# -------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# -------------------------------------------------------
# CORS — Allowed Origins
# In production: your Vercel frontend URL (no trailing slash)
# -------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,https://zathelabel.vercel.app

# -------------------------------------------------------
# FRONTEND — Next.js Public Env Vars
# In production: same domain as frontend (Vercel URL)
# -------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# -------------------------------------------------------
# STORE CONFIG
# -------------------------------------------------------
# WhatsApp number with country code (no +, no spaces)
WHATSAPP_NUMBER=2348000000000
