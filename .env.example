# ============================================================
# ZA Fashion E-Commerce — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=za_db
POSTGRES_USER=za_user
POSTGRES_PASSWORD=your_strong_password_here

# --- Backend ---
SECRET_KEY=your_super_secret_jwt_key_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cloudinary (required for image uploads) ---
# Sign up at https://cloudinary.com and get credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# --- Store Config ---
# WhatsApp number with country code (no +, no spaces)
WHATSAPP_NUMBER=2348000000000
